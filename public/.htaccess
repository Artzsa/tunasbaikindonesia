# ============================================================
# Tunas Baik Indonesia - Hostinger / Apache configuration
# Deploy root: public_html (isi folder public/)
# ============================================================

# --- Dasar ---
Options -Indexes
DirectoryIndex index.html
AddDefaultCharset UTF-8

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>

# --- Paksa HTTPS ---
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Jangan ganggu validasi/renewal SSL Let's Encrypt
  RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Satukan www ke domain utama agar URL konsisten dengan canonical.
  RewriteCond %{HTTP_HOST} ^www\.tunasbaikindonesia\.org\.id$ [NC]
  RewriteRule ^ https://tunasbaikindonesia.org.id%{REQUEST_URI} [L,R=301]

  # Jangan pernah menyajikan file/folder internal jika ikut terunggah
  RewriteRule (^|/)\.git - [F,L]
  RewriteRule ^docs/ - [F,L]
</IfModule>

# --- Tolak dotfiles & file internal ---
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

<Files "AGENTS.md">
  Require all denied
</Files>

# --- Halaman 404 ---
ErrorDocument 404 /404.html

# --- Security headers ---
<IfModule mod_headers.c>
  Header always unset X-Powered-By

  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set X-Permitted-Cross-Domain-Policies "none"

  # HSTS: mulai tanpa includeSubDomains/preload.
  # Aktifkan includeSubDomains/preload hanya setelah semua subdomain siap HTTPS.
  Header always set Strict-Transport-Security "max-age=31536000"

  # CSP dihitung dari inline script/style di public/index.html.
  # Jika blok inline tersebut diubah, hash harus diperbarui.
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' 'sha256-/x7W7R75k8Roq0WaVRQX9blP4OufE5xbAdzklGxsgpw=' 'sha256-I5fb+/2wrF4xqs0iwzh/PtXERa7zfLByH2Y81pbGTfQ='; style-src 'self' 'sha256-DqKCBJ7H/pzXtXiC4gC63u7q0LTBvw7RbCfUFRriL2M='; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; frame-src 'none'; upgrade-insecure-requests"

  Header append Vary Accept-Encoding
</IfModule>

# --- Kompresi ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# --- Cache ---
<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>

  <FilesMatch "\.(webp|png|jpe?g|gif|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
